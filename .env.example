DATABASE_URL="file:./dev.db"
# Production uses PostgreSQL with the separate prisma-postgres schema.
# See docs/production-postgres.md and .env.production.example.
# DATABASE_URL="postgresql://ktsa_user:change-me@localhost:5432/ktsa?schema=public"
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY="your-deepseek-api-key"
LLM_MODEL="deepseek-chat"
LLM_TIMEOUT_MS="60000"
LLM_MAX_RETRIES="2"
LLM_TEMPERATURE="0.4"
LLM_PROMPT_VERSION="v1"
# Optional. Fill this if your network needs a proxy to reach DeepSeek/OpenAI.
# LLM_PROXY_URL="http://127.0.0.1:7897"
# Optional. Use this only when local fake-ip DNS breaks TLS for the LLM host.
# Format: "hostname=ip"
# LLM_RESOLVE_IP="api.deepseek.com=3.173.21.63"
