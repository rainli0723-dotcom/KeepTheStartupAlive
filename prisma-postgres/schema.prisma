generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrganizationProfile {
  id                  String   @id @default(cuid())
  name                String
  stage               String
  industry            String
  product             String
  market              String
  cashflow            Int      @default(60)
  revenue             String   @default("not_set")
  teamSize            Int      @default(1)
  governanceStructure String   @default("founder_led")
  keyRisks            String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspaces SimulationWorkspace[]
  documents  OrganizationDocument[]
  archives  OrganizationArchive[]
}

model OrganizationArchive {
  id                  String   @id @default(cuid())
  name                String
  stage               String
  industry            String
  product             String
  market              String
  cashflow            Int
  revenue             String
  teamSize            Int
  governanceStructure String
  keyRisks            String
  organizationProfileId String
  simulationEndedAt  DateTime @default(now())
  finalOutcome       String?
  finalScore        Int?
  
  organizationProfile OrganizationProfile @relation(fields: [organizationProfileId], references: [id], onDelete: Cascade)
}

model OrganizationDocument {
  id                    String   @id @default(cuid())
  organizationProfileId String
  fileName              String
  mimeType              String
  extractedText         String
  sourceKind            String
  createdAt             DateTime @default(now())

  organizationProfile   OrganizationProfile @relation(fields: [organizationProfileId], references: [id], onDelete: Cascade)
}

model SimulationWorkspace {
  id                   String   @id @default(cuid())
  name                 String
  organizationStage    String
  sandboxType          String
  currentCycle         Int      @default(1)
  status               String   @default("active")
  organizationState    String
  selectedRoleNames    String
  userRole             String   @default("CEO")
  selectedScenarioId   String?
  tenantId             String?
  organizationProfileId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant              EnterpriseTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organizationProfile OrganizationProfile @relation(fields: [organizationProfileId], references: [id], onDelete: Cascade)
  teamMembers         TeamMember[]
  events              BusinessEvent[]
  meetings            StrategyMeeting[]
  finales             SimulationFinale[]
}

model EnterpriseTenant {
  id          String   @id @default(cuid())
  name        String
  plan        String   @default("trial")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaces  SimulationWorkspace[]
  members     TenantMember[]
  invitations TenantInvitation[]
  auditLogs   AuditLog[]
  users       AppUser[]
  llmCallLogs LlmCallLog[]
  llmJobs     LlmJob[]
  promptVersions PromptVersion[]
  reportShareLinks ReportShareLink[]
  comments    CollaborationComment[]
  ssoSettings  TenantSsoSetting[]
  usageLimits  TenantUsageLimit?
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  name      String
  email     String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    EnterpriseTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TenantInvitation {
  id          String   @id @default(cuid())
  tenantId    String
  email       String
  role        String   @default("viewer")
  tokenHash   String   @unique
  status      String   @default("pending")
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      EnterpriseTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantSsoSetting {
  id           String   @id @default(cuid())
  tenantId     String
  provider     String
  issuer       String
  clientId     String
  clientSecret String?
  status       String   @default("disabled")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       EnterpriseTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model TenantUsageLimit {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  trialEndsAt    DateTime?
  monthlyLlmCalls Int     @default(500)
  monthlyExports  Int     @default(50)
  monthlyWorkspaces Int   @default(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         EnterpriseTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AppUser {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       EnterpriseTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships  TenantMember[]
  sessions     AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actor       String   @default("system")
  action      String
  entityType  String
  entityId    String?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  tenant      EnterpriseTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model LlmCallLog {
  id              String   @id @default(cuid())
  tenantId        String?
  task            String   @default("structured_call")
  provider        String
  model           String
  status          String
  attemptCount    Int      @default(1)
  durationMs      Int      @default(0)
  promptTokens    Int?
  completionTokens Int?
  totalTokens     Int?
  estimatedCostUsd Float?
  promptVersionId String?
  modelConfig     String   @default("{}")
  errorMessage    String?
  requestHash     String
  createdAt       DateTime @default(now())

  tenant          EnterpriseTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
}

model LlmJob {
  id           String   @id @default(cuid())
  tenantId     String?
  task         String
  status       String   @default("queued")
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  timeoutMs    Int      @default(60000)
  runAfter     DateTime @default(now())
  payload      String
  result       String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?

  tenant       EnterpriseTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model PromptVersion {
  id          String   @id @default(cuid())
  tenantId    String?
  task        String
  version     String
  systemPrompt String
  outputSchema String
  status      String   @default("active")
  createdBy   String   @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      EnterpriseTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  llmCallLogs LlmCallLog[]

  @@unique([tenantId, task, version])
}

model SimulationFinale {
  id             String   @id @default(cuid())
  workspaceId    String
  completedCycles Int
  outcomeType    String
  title          String
  summary        String
  score          Int
  keyDrivers     String
  decisionTrace  String
  alternativeEndings String
  nextActions    String
  rawReport      String
  createdAt      DateTime @default(now())

  workspace      SimulationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shareLinks     ReportShareLink[]
  comments       CollaborationComment[]
}

model CollaborationComment {
  id        String   @id @default(cuid())
  tenantId  String
  finaleId  String
  authorId  String?
  author    String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    EnterpriseTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finale    SimulationFinale @relation(fields: [finaleId], references: [id], onDelete: Cascade)
}

model ReportShareLink {
  id          String   @id @default(cuid())
  tenantId    String?
  finaleId    String
  tokenHash   String   @unique
  title       String
  status      String   @default("active")
  expiresAt   DateTime?
  createdBy   String   @default("system")
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  tenant      EnterpriseTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  finale      SimulationFinale @relation(fields: [finaleId], references: [id], onDelete: Cascade)
}

model RoleTemplate {
  id                 String   @id @default(cuid())
  name               String   @unique
  category           String
  stages             String
  sandboxTypes       String
  defaultCapabilities String
  defaultMetrics     String
  description        String
  createdAt          DateTime @default(now())
}

model TeamMember {
  id                   String   @id @default(cuid())
  workspaceId           String
  name                 String
  roleName             String
  isRealMember         Boolean  @default(false)
  capabilities         String
  customMetrics        String
  personality          String
  communicationStyle   String
  decisionPreference   String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace            SimulationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceDocuments      SourceDocument[]
  distillationProfile  DistillationProfile?
}

model SourceDocument {
  id            String   @id @default(cuid())
  teamMemberId  String
  fileName      String
  mimeType      String
  extractedText String
  sourceKind    String
  createdAt     DateTime @default(now())

  teamMember    TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
}

model DistillationProfile {
  id                 String   @id @default(cuid())
  teamMemberId        String   @unique
  languageStyle       String
  decisionPreference  String
  values              String
  pressureResponse    String
  capabilityTendency  String
  typicalPhrases      String
  professionalBoundary String
  rawProfile          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  teamMember          TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
}

model Scenario {
  id          String   @id @default(cuid())
  name        String
  sandboxType String
  stage       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes ScenarioNode[]
}

model ScenarioNode {
  id          String @id @default(cuid())
  scenarioId  String
  nodeType    String
  title       String
  content     String
  effect      String
  sortOrder   Int

  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model BusinessEvent {
  id          String   @id @default(cuid())
  workspaceId String
  cycle       Int
  eventType   String
  title       String
  description String
  impact      String
  createdAt   DateTime @default(now())

  workspace   SimulationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meetings    StrategyMeeting[]
}

model StrategyMeeting {
  id              String   @id @default(cuid())
  workspaceId      String
  businessEventId  String?
  cycle           Int
  chair           String
  agenda          String
  participantViews String
  userInput       String
  conclusion      String
  createdAt       DateTime @default(now())

  workspace       SimulationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessEvent   BusinessEvent? @relation(fields: [businessEventId], references: [id], onDelete: SetNull)
  decisionOptions DecisionOption[]
}

model DecisionOption {
  id              String @id @default(cuid())
  meetingId       String
  title           String
  recommendation  String
  upside          String
  risk            String
  resourceNeed    String
  impactScore     String
  nextIndicators  String

  meeting         StrategyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

