DATABASE_URL="postgresql://ktsa_user:change-me@localhost:5432/ktsa?schema=public"

LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY="your-production-llm-api-key"
LLM_MODEL="deepseek-chat"
LLM_TIMEOUT_MS="120000"
LLM_MAX_RETRIES="2"
LLM_TEMPERATURE="0.4"
LLM_PROMPT_VERSION="v1"
LLM_WORKER_TOKEN="change-me-worker-token"
LLM_MODEL_RATES_JSON="{\"deepseek-chat\":{\"input\":0.27,\"output\":1.1}}"

DATABASE_POOL_MIN="2"
DATABASE_POOL_MAX="10"
DATA_RETENTION_DAYS="365"
REPORT_SHARE_DEFAULT_DAYS="30"

NODE_ENV="production"
